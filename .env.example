# ============================================================
# Discord Website Monitor - Environment Variables
# Copy file ini menjadi .env untuk development lokal.
# JANGAN pernah commit file .env ke GitHub.
# ============================================================

# Bot Token dari Discord Developer Portal > Bot > Reset Token.
# Dipakai untuk memanggil Discord REST API (kirim/edit message).
DISCORD_TOKEN=

# Application ID (Client ID) dari Discord Developer Portal > General Information.
# Dipakai untuk register slash command & identifikasi message milik bot.
DISCORD_CLIENT_ID=

# Public Key dari Discord Developer Portal > General Information.
# WAJIB untuk memverifikasi signature Ed25519 dari setiap HTTP Interaction.
# Tanpa ini endpoint /api/interactions tidak bisa dipercaya (dan Discord akan menolak).
DISCORD_PUBLIC_KEY=

# ID server Discord tempat slash command didaftarkan (registrasi guild = instan).
# Juga dipakai cron untuk menemukan channel yang berisi monitor board.
DISCORD_GUILD_ID=

# Secret acak untuk melindungi endpoint /api/cron.
# Buat dengan: openssl rand -hex 32
# Vercel Cron otomatis mengirim header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# (Opsional) Batasi pencarian monitor board hanya ke channel tertentu.
# Pisahkan dengan koma. Sangat disarankan untuk server besar agar hemat rate limit.
# MONITOR_CHANNEL_IDS=123456789012345678,987654321098765432

# (Opsional) Timeout HTTP request per website dalam milidetik. Default 10000 (10 detik).
# CHECK_TIMEOUT_MS=10000

# (Opsional) Timezone untuk tampilan "Last Check". Default Asia/Jakarta (WIB).
# DISPLAY_TIMEZONE=Asia/Jakarta

# (Opsional) Maksimum website per monitor board. Default 15 (batas ukuran state).
# MAX_SITES=15
